# ==============================================================================
# TRUSTLAYER — CONFIGURATION & ENVIRONMENT VARIABLES
# ==============================================================================

# LLM Provider API Keys (Leave blank to use the high-fidelity demo simulation mode)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""

# Multi-Agent Model Selection
AGENT_A_PROVIDER="openai"
AGENT_A_MODEL="gpt-4o-mini"

AGENT_B_PROVIDER="gemini"
AGENT_B_MODEL="gemini-1.5-flash"

AUDITOR_PROVIDER="openai"
AUDITOR_MODEL="gpt-4o-mini"

# Retrieval & Verification Limits
RETRIEVAL_TOP_K=3
RETRY_TOP_K_STEP_1=5
RETRY_TOP_K_STEP_2=8
MAX_RETRIES=2
CONFIDENCE_THRESHOLD=0.80

# Server Host & Ports
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000
STREAMLIT_PORT=8501


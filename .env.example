# OpenAI API Key (required for real mode, omit/mock if MOCK_LLM=1)
OPENAI_API_KEY=your_openai_api_key_here

# Model Selection (defaults auto-resolved at startup via client.models.list())
# Cost-efficient chat model for Agent A
ANSWER_MODEL_A=gpt-4o-mini
# Agent B: must differ from Agent A. Default is a different OpenAI model family.
ANSWER_MODEL_B=gpt-4.1-mini
# OPTIONAL: run Agent B on a different vendor (any OpenAI-compatible endpoint). Example for Gemini:
# AGENT_B_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AGENT_B_API_KEY=your_gemini_key
# ANSWER_MODEL_B=gemini-2.0-flash
# Strong verification model for Auditor and Finalizer
AUDITOR_MODEL=gpt-4o
# Embedding model for vector indexing and search
EMBED_MODEL=text-embedding-3-small

# Operational Modes
# Set MOCK_LLM=1 for fully deterministic offline mock execution without an API key
MOCK_LLM=0
# Set CACHE=0 to bypass on-disk caching of LLM and embedding responses
CACHE=1

# Verification & Retrieval Thresholds
MIN_SIM=0.35
SUPPORT_THRESHOLD=0.85
MAX_RETRIES=2

# Server Port
PORT=8000
HOST=0.0.0.0

